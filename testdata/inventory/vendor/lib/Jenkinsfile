pipeline {
  agent {
    label 'linux-large'
  }

  triggers {
    cron('H 4 * * 1-5')
  }

  environment {
    DEPLOY_TOKEN = credentials('deploy-token')
  }

  stages {
    stage('Build') {
      agent {
        docker {
          image 'golang:1.23'
        }
      }
      steps {
        sh 'make build'
        archiveArtifacts artifacts: 'dist/**'
        stash name: 'compiled', includes: 'dist/**'
      }
    }

    stage('Test') {
      steps {
        unstash 'compiled'
        junit 'reports/*.xml'
        sh "curl https://quality.example.com/api?token=${QUALITY_TOKEN}"
        script {
          runDynamicChecks()
        }
      }
    }
  }
}
